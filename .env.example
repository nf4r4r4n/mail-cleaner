# Google OAuth2 (creer dans Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Serveur
PORT=3000
HOST=127.0.0.1

# Seuil de score minimum pour candidat (defaut 4)
MIN_SCORE=4
# Age (jours) au-dela duquel une notification est "perimee" (defaut 90)
STALE_DAYS=90

# Dossier de donnees (SQLite, tokens)
DATA_DIR=./data
